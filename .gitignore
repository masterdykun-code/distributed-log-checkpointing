# Python cache / virtual environment
__pycache__/
*.py[cod]
.venv/

# Local tooling artifacts
.pdf_tools/

# Large/reference files that should not be committed
*.pdf

# Runtime logs are generated by demo/workload scripts
logs/*.log
logs/delayed_site_demo/
!logs/.gitkeep

# Runtime coordinator state is regenerated by demos/workloads
data/global_tx_table.json

# Checkpoint metrics and snapshots are regenerated by demo scripts
metrics/*
!metrics/.gitkeep
snapshots/*
!snapshots/.gitkeep

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
